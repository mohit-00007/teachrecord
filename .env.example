# TeachRecord runs entirely client-side (browser or Electron) with no
# server-side API calls, so there are currently no required environment
# variables. This file is kept as a placeholder for future configuration.
#
# DISABLE_HMR: set to "true" to disable Vite's dev-server file watching
# (useful when an automated agent is editing files and you want to avoid
# HMR flicker). Optional, defaults to enabled.
# DISABLE_HMR=true
